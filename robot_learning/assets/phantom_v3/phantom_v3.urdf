<?xml version="1.0"?>
<robot name="l_phantom_v3">
  <material name="root_green"><color rgba="0.05 0.62 0.35 1"/></material>
  <material name="elbow_orange"><color rgba="0.95 0.35 0.05 1"/></material>
  <material name="tip_purple"><color rgba="0.42 0.22 0.85 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>
  <link name="v3_part0_root">
    <visual name="v3_part0_root_mesh">
      <geometry><mesh filename="v3_part0_root.obj" scale="0.001 0.001 0.001"/></geometry>
      <material name="root_green"/>
    </visual>
    <visual name="v3_part0_root_label">
      <origin xyz="0.050 0.019 0.006"/>
      <geometry><sphere radius="0.004"/></geometry>
      <material name="white"/>
    </visual>
    <collision name="part0_bar_collision">
      <origin xyz="0.055000 0 0"/>
      <geometry><box size="0.110000 0.030000 0.018000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05982472 0.00007177 0.00077157"/>
      <mass value="0.40000"/>
      <inertia ixx="0.0000393347" ixy="0.0000002246"
        ixz="-0.0000227326" iyy="0.0009296295"
        iyz="-0.0000001214" izz="0.0009467782"/>
    </inertial>
  </link>
  <link name="v3_part1_elbow">
    <visual name="v3_part1_elbow_mesh">
      <geometry><mesh filename="v3_part1_elbow.obj" scale="0.001 0.001 0.001"/></geometry>
      <material name="elbow_orange"/>
    </visual>
    <visual name="v3_part1_elbow_label">
      <origin xyz="0.055 -0.010 0.013"/>
      <geometry><sphere radius="0.004"/></geometry>
      <material name="white"/>
    </visual>
    <collision name="part1_bar_collision">
      <origin xyz="0.055000 0 0"/>
      <geometry><box size="0.030000 0.030000 0.018000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05944421 0.00280704 -0.00123153"/>
      <mass value="0.33000"/>
      <inertia ixx="0.0000330458" ixy="-0.0000366994"
        ixz="-0.0000198198" iyy="0.0004484235"
        iyz="-0.0000011766" izz="0.0004594151"/>
    </inertial>
  </link>
  <link name="v3_part2_tip">
    <visual name="v3_part2_tip_mesh">
      <geometry><mesh filename="v3_part2_tip.obj" scale="0.001 0.001 0.001"/></geometry>
      <material name="tip_purple"/>
    </visual>
    <visual name="v3_part2_tip_label">
      <origin xyz="0.062 0.007 0.013"/>
      <geometry><sphere radius="0.004"/></geometry>
      <material name="white"/>
    </visual>
    <collision name="part2_bar_collision">
      <origin xyz="0.062500 0 0"/>
      <geometry><box size="0.045000 0.030000 0.018000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.04154190 -0.00310785 0.00005978"/>
      <mass value="0.27000"/>
      <inertia ixx="0.0000273382" ixy="-0.0000262571"
        ixz="-0.0000003302" iyy="0.0002350796"
        iyz="-0.0000001632" izz="0.0002435316"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="v3_part0_root"/><child link="v3_part1_elbow"/>
    <origin xyz="0.15000 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.32128791" upper="2.32128791" effort="10" velocity="2"/>
    <dynamics damping="0.03" friction="0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="v3_part1_elbow"/><child link="v3_part2_tip"/>
    <origin xyz="0.11000 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.56563400" upper="2.60054059" effort="10" velocity="2"/>
    <dynamics damping="0.03" friction="0"/>
  </joint>
</robot>
