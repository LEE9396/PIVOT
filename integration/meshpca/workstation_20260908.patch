+"""CSV 기록은 실제 장비 없이 검사한다."""
+
+import tempfile
+import unittest
+import json
+import time
+from datetime import datetime
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from pivot.rb5_ui import App, CSV_HEADER, next_measurement_csv, open_measurement_csv
+
+
+class MeasurementCsvTest(unittest.TestCase):
+    def test_position_uses_existing_driver_and_rejects_invalid_or_stale_input(self):
+        calls = []
+        app = SimpleNamespace(gripper=SimpleNamespace(move=lambda *v: calls.append(v)),
+                              speed=SimpleNamespace(get=lambda: 16),
+                              force=SimpleNamespace(get=lambda: 16),
+                              gripper_sample=dict(timestamp_s=time.time(), activated=True,
+                                                  status=3, fault=0),
+                              run_gripper=lambda fn, label: fn())
+        App.move_gripper_position(app, 11)
+        self.assertEqual(calls, [(11, 16, 16)])
+        for invalid in (True, -1, 256, 11.5, "11", None):
+            with self.assertRaises(ValueError):
+                App.move_gripper_position(app, invalid)
+        app.gripper_sample['timestamp_s'] -= 10
+        with self.assertRaises(ValueError):
+            App.move_gripper_position(app, 11)
+        self.assertEqual(len(calls), 1)
+
+    def test_restart_does_not_replay_old_command(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'hardware_command.json'
+            path.write_text(json.dumps(dict(id='old', action='close')))
+            app = SimpleNamespace(command_file=path, command_started_at_s=path.stat().st_mtime+1,
+                                  move_gripper=Mock(), last_command_id=None)
+            App.consume_command(app)
+            app.move_gripper.assert_not_called()
+            self.assertIsNone(app.last_command_id)
+
+    def test_each_measurement_gets_a_timestamped_file(self):
+        with tempfile.TemporaryDirectory() as directory:
+            template = Path(directory) / "Latch Measurement.csv"
+            path = next_measurement_csv(
+                template, datetime(2026, 9, 4, 18, 45, 12, 123456))
+            self.assertEqual(path.name,
+                             "Latch Measurement_20260904_184512_123456.csv")
+            handle, writer = open_measurement_csv(path)
+            writer.writerow([1.0, 1, 2, 3, 4, 5, 6])
+            handle.close()
+            rows = path.read_text().splitlines()
+            self.assertEqual(rows[0].split(","), list(CSV_HEADER))
+            self.assertEqual(len(rows), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
