+def grabcut_box(image, box):
+    """수동 박스 안의 전경을 로컬 OpenCV로 분리한다."""
+    import cv2
+
+    rgb = np.asarray(image)
+    height, width = rgb.shape[:2]
+    x0, y0, x1, y1 = map(int, box)
+    x0, x1 = sorted((max(0, x0), min(width, x1)))
+    y0, y1 = sorted((max(0, y0), min(height, y1)))
+    if x1 - x0 < 3 or y1 - y0 < 3:
+        raise ValueError("선택 박스가 너무 작습니다")
+    mask = np.zeros((height, width), np.uint8)
+    background = np.zeros((1, 65), np.float64)
+    foreground = np.zeros((1, 65), np.float64)
+    cv2.grabCut(cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR), mask,
+                (x0, y0, x1 - x0, y1 - y0), background, foreground, 5,
+                cv2.GC_INIT_WITH_RECT)
+    result = (mask == cv2.GC_FGD) | (mask == cv2.GC_PR_FGD)
+    result[:y0] = False
+    result[y1:] = False
+    result[:, :x0] = False
+    result[:, x1:] = False
+    # 가느다란 Arm은 GrabCut이 전부 배경으로 지우기도 한다. 사용자가 직접
+    # 지정한 박스가 최후의 안전장치다. 0픽셀로 추적기를 죽이는 것보다 박스
+    # 안의 깊이점을 FoundationPose가 거르게 두는 편이 낫다.
+    if result.sum() < 500:
+        result[y0:y1, x0:x1] = True
+    return result
+
+
+def keep_small_box_parts(masks, boxes):
+    """겹친 픽셀은 더 작고 구체적인 선택 박스 쪽에 남긴다."""
+    claimed = np.zeros_like(next(iter(masks.values())), dtype=bool)
+    output = {}
+    for name in sorted(masks, key=lambda key: ((boxes[key][2] - boxes[key][0])
+                                                * (boxes[key][3] - boxes[key][1]))):
+        output[name] = masks[name] & ~claimed
+        claimed |= output[name]
+    return output
+
