# 실물 실험 설정 — 이 파일을 experiment.conf 로 복사해 PC 에 맞게 고칩니다.
#
#   cp setup/experiment.conf.example setup/experiment.conf
#
# setup/launch_experiment.sh 가 이 값을 읽어 창 4개를 띄웁니다.
# 경로에 ~ 를 써도 됩니다.

# ---- 저장소 위치 -----------------------------------------------------------
PIVOT_ROOT=~/Desktop/PIVOT
MESHPCA_ROOT=~/MeshPCA
FOUNDATIONPOSE_ROOT=~/FoundationPose
SAM3_ROOT=~/sam3

# ---- 파이썬 환경 -----------------------------------------------------------
# 창 3 (Tk UI) 이 쓰는 MeshPCA venv 의 파이썬
MESHPCA_PYTHON=~/MeshPCA/.venv/bin/python
# 창 2 (FoundationPose) 가 쓰는 conda 환경 이름
FOUNDATIONPOSE_CONDA_ENV=bundlesdf
# SAM3 전용 파이썬 (없으면 위 환경과 같게 두세요)
SAM3_PYTHON=~/miniforge3/envs/sam3/bin/python
FOUNDATIONPOSE_PYTHON=~/miniforge3/envs/bundlesdf/bin/python

# ---- 장비 -----------------------------------------------------------------
ROBOT_HOST=192.168.50.51
AFT_HOST=192.168.50.51
GRIPPER_PORT=/dev/ttyUSB0
# 파지력 [N] 20~235. 얇은 플라스틱은 낮추세요.
GRIPPER_FORCE=205

# ---- 물체 -----------------------------------------------------------------
LAMP_ASSET_DIR=~/Desktop/PIVOT/assets/final_objects/lamp
LAPTOP_ASSET_DIR=~/Desktop/PIVOT/assets/final_objects/laptop
# desklamp 또는 3link / 2link
OBJECT=desklamp
# PIVOT 이 잡는 부위 (desklamp 전용). link_3 = 연결부/팔
GRASP_PART=link_3

# 밀도 계산의 모멘트팔을 무엇으로 세울 것인가.
#
#   legacy    자산에 적어둔 **짐작** 파지점 (위치만, 회전 없음). 지금까지의 동작.
#             컴퓨터가 정한 자리에 사람이 맞춰 잡아야 하고, 지난 세션에서
#             그 어긋남이 43 mm 였다.
#   measured  사람이 원하는 곳에 잡히면 카메라(FoundationPose)가 그 자리를
#             읽어 와서 그대로 쓴다. **이 연구의 설계가 이쪽이다.**
#
# 로봇 장면(충돌·도달 검사)은 이미 실측값을 쓰고 있다. 밀도 계산만 짐작값을
# 쓰고 있었다.
#
# 켜기 전에 반드시 tools/check_grasp_frames.py 를 돌려라. 회전 차이가 수십
# 도로 나오면 그건 사람의 파지 오차가 아니라 **메시 좌표계 규약이 서로 다른
# 것**이고, 그 상태로 켜면 지금보다 나빠진다. session_20260904_1736 의
# grasp.json 으로 돌리면 10.07 도(정상 범위)다. 새 파지마다 다시 돌려라.
GRASP_FRAME=measured
# 저울로 잰 총질량 [kg], **힌지까지 붙은 채로**. 토크만 쓰는 추정에서 규모를
# 정하는 유일한 값이라 실물에서는 필수다 (없으면 dual_view 가 시작을 거부).
TOTAL_MASS_KG=0.571
# 파지 오프셋 사전평균 [mm]. GRASP_FRAME=measured 에서는 **반드시 비운다** —
# 실측 파지가 이미 회귀행렬 기하에 들어가므로 여기 또 넣으면 이중 계산이다.
# legacy 프레임에서만 tools/check_grasp_frames.py 가 찍는 벡터를 넣는다.
GRASP_MU_MM=
# 힘 3축을 추정에 다시 넣고 싶을 때만 1. 기본은 토크 3축만 쓴다 (힘 블록은
# 총질량 정보뿐이고, 그 채널에 세션 20260904 에서 58.7 N 오프셋이 실렸다).
# USE_FORCE=1
# FoundationPose 가 추적하는 부위 이름 (파지점을 계산할 메시)
FP_GRASP_PART=support
FP_MESH_DIR=~/Desktop/PIVOT/assets/final_objects/lamp/visual_meshes
# FoundationPose 가 추적할 메시를 **직접** 지정한다 (비워 두면 위 둘로 만든다).
# FoundationPose 메시와 밀도 모델 메시는 반드시 같아야 한다. 다르면 카메라가
# 읽어 준 물체 자세가 다른 좌표계의 값이 되어 파지점이 통째로 어긋나는데,
# 화면에는 아무 표시도 안 난다. 런처가 둘을 비교해서 다르면 알려 준다.
FP_GRASP_MESH_OVERRIDE=

# 창 3 (그리퍼 + F/T) 에 같이 띄울 표. 비워 두면 안 띄운다.
# 걸쇠 실험 표(Latch Measurement.csv)는 이 실험과 상관이 없어 기본은 꺼 둔다.
WIN3_CSV=
GAUSSIAN_DIR=
# 비워 두면 저장소의 visual_meshes를 이름표로 사용한다.
GAUSSIAN_FILES=base=base.obj,support=support.obj,head=head.obj
FP_LIVE_SCRIPT=foundationpose/run_desk_lamp_live.py
FP_CAMERA_WIDTH=640
FP_CAMERA_HEIGHT=480
FP_CAMERA_FPS=30
FP_ANGLE_WINDOW=10
CAMERA_FOV_MARGIN_PX=20
MANUAL_MASK=1
# 같은 물체·같은 위치에서 UI만 재시작할 때 외부에서 REUSE_INIT=1 로 실행합니다.

# ---- 미리 만들어 둔 파일 ----------------------------------------------------
# 3자세 영점 조정 (MeshPCA pivot/tare_real.py 산출)
TARE_FILE=~/Desktop/PIVOT/calibration/aft_tare_current.json
# 0: 실험 시작 때 측정한 영점 조정을 세션 동안 재사용
TARE_MAX_AGE_S=0
# FoundationPose 초기화 입력 (한 번 캡처해 두면 --reuse-init 로 재사용)
FP_INIT_RGB=/tmp/lamp_live_rgb.png
FP_INIT_DEPTH=/tmp/lamp_live_depth_m.npy
FP_INTRINSICS=/tmp/lamp_live_intrinsics.json
FP_MASKS=/tmp/lamp_sam3_masks
FP_OUTPUT=/tmp/lamp_foundationpose_live

# ---- 탐색 설정 -------------------------------------------------------------
# 정지 조건: 밀도의 95% 상대 반폭
TARGET=0.05
MAX_ROUNDS=8
# 이동 하나에 쓰는 시간 [s]. 클수록 준정적.
MOVE_DURATION=8

# 현재 통합 UI 기준. 물리 배치가 다르면 자세/오차를 다시 측정한다.
TARE_MODE=gravity
ANGLE_FLOOR_DEG=3.0
ANGLE_REL_ERROR=0.0
# 파지 오프셋 미지수의 사전분포 폭 [mm]. FoundationPose 위치 오차 10 mm 에
# 손-눈 오차(자세 1 deg ≈ 팔 0.5 m 에서 8.7 mm)가 더해지므로 15~20.
GRASP_SIGMA_MM=15.0
ANGLE_MARGIN_DEG=0.0
PART_NAMES=base,support,head
# START_ARM_DEG="J1 J2 J3 J4 J5 J6"  # 현장에서 확인한 시작 자세 [deg]
